"""Partial charges from {{ model_name }}.

Unlike the energy model, an electrostatic model is a one-shot script: Avogadro
runs it, it reads the whole molecule from stdin, prints one JSON object, and
exits. There is no loop and no binary protocol.
"""

import json
import sys

import numpy as np


def run():
    bootstrap = json.load(sys.stdin)
    mol_cjson = bootstrap["cjson"]

    numbers = np.array(mol_cjson["atoms"]["elements"]["number"])
    coords = np.array(
        mol_cjson["atoms"]["coords"]["3d"], dtype=float
    ).reshape(-1, 3)
    total_charge = float(bootstrap.get("charge", 0.0))

    charges = _partial_charges(numbers, coords, total_charge)

    # Avogadro expects one charge per atom, in the order the atoms arrived.
    print(json.dumps({"charges": [float(q) for q in charges]}))


def _partial_charges(numbers, coords, total_charge):
    """Return one partial charge per atom, in elementary charge units.

    This placeholder spreads the total charge evenly, which is a valid answer
    only for a homonuclear system. Replace it with the real calculation, e.g.

        results = calculator(data)
        return results["charges"][0]

    and keep the sum equal to the total charge: Avogadro does not renormalize.
    """
    return np.full(len(numbers), total_charge / len(numbers), dtype=float)

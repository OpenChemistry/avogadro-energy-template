{%- if support_hessians %}


def test_hessian_is_square_and_symmetric(water):
    coords = coordinates(water)
    (hessian,) = exchange(water, [(coords, FLAG_REQUEST_HESSIAN)])

    dim = coords.size
    assert hessian.shape == (dim, dim)
    assert hessian == pytest.approx(hessian.T)


def test_hessian_rows_are_gradient_derivatives(water):
    """Row k of the Hessian is d(gradient)/dx_k."""
    coords = coordinates(water)
    step = 1.0e-3
    k = 0

    plus, minus = coords.copy(), coords.copy()
    plus.flat[k] += step
    minus.flat[k] -= step

    hessian, gradient_plus, gradient_minus = exchange(
        water,
        [
            (coords, FLAG_REQUEST_HESSIAN),
            (plus, FLAG_REQUEST_GRADIENT),
            (minus, FLAG_REQUEST_GRADIENT),
        ],
    )

    expected = (gradient_plus - gradient_minus).reshape(-1) / (2.0 * step)
    assert hessian[k] == pytest.approx(expected, rel=1e-3, abs=1e-3)
